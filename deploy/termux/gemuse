#!/data/data/com.termux/files/usr/bin/bash
# GemuseAPI di Termux: server mengendalikan Chrome Android lewat adb (debug nirkabel) -> CDP.
# Perintah: gemuse start|stop|restart|status|login|pair|update|logs|key
set -uo pipefail

DIR=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
PORT=18610
CDP=9333
LOG="$DIR/data/termux-server.log"
PIDF="$DIR/data/termux-server.pid"
CHROME=com.android.chrome

say() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mGAGAL:\033[0m %s\n' "$*" >&2; exit 1; }

api_key() { sed -n 's/^MUSE2API_KEY=//p' "$DIR/.env" | tail -1; }
serial() { adb devices 2>/dev/null | awk 'NR>1 && $2=="device" {print $1; exit}'; }
running() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
healthy() { curl -fsm3 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1; }
cdp_ok() { curl -fsm3 "http://127.0.0.1:$CDP/json/version" 2>/dev/null | grep -q webSocketDebuggerUrl; }

cmd_pair() {
  cat <<'EOF'
Pairing debug nirkabel (cukup sekali per HP):
  1. Setelan > Tentang ponsel > ketuk "Nomor build" 7x (aktifkan Opsi developer).
  2. Setelan > Sistem > Opsi developer > nyalakan "Debug nirkabel".
  3. Buka mode LAYAR TERPISAH (split screen): Termux + Setelan.
     Popup kode pairing tertutup kalau Anda pindah aplikasi.
  4. Di Setelan: Debug nirkabel > "Sambungkan perangkat dengan kode pairing".
EOF
  local pp code
  read -rp "Port di popup (angka setelah titik dua, mis. 37145): " pp
  read -rp "Kode pairing 6 digit: " code
  adb pair "127.0.0.1:$pp" "$code" || die "Pairing gagal. Pastikan popup masih terbuka dan kodenya benar, lalu ulangi: gemuse pair"
  say "Pairing berhasil."
}

connect_adb() {
  [ -n "$(serial)" ] && return 0
  adb start-server >/dev/null 2>&1
  local hp p
  # Port debug nirkabel berubah setiap kali dinyalakan ulang; coba temukan lewat mDNS dulu.
  hp=$(adb mdns services 2>/dev/null | awk '/_adb-tls-connect/ {print $NF; exit}')
  [ -n "$hp" ] && adb connect "127.0.0.1:${hp##*:}" >/dev/null 2>&1
  [ -n "$(serial)" ] && return 0
  warn "adb belum tersambung ke HP ini."
  echo "Buka Setelan > Opsi developer > Debug nirkabel (pastikan NYALA), lihat 'Alamat IP & Port'."
  read -rp "Ketik PORT-nya (angka setelah titik dua), atau Enter kalau belum pernah pairing: " p
  if [ -z "$p" ]; then
    cmd_pair
    read -rp "Sekarang ketik PORT dari 'Alamat IP & Port': " p
  fi
  adb connect "127.0.0.1:$p" >/dev/null 2>&1
  [ -n "$(serial)" ] || die "Tidak bisa tersambung ke 127.0.0.1:$p. Cek Debug nirkabel masih nyala, lalu: gemuse start"
}

prep_android() {
  local s; s=$(serial)
  # Android 12+ membunuh proses anak Termux ("phantom process"); matikan batasnya.
  adb -s "$s" shell device_config put activity_manager max_phantom_processes 2147483647 >/dev/null 2>&1
  adb -s "$s" shell settings put global settings_enable_monitor_phantom_procs false >/dev/null 2>&1
  # Jangan dibekukan penghemat baterai.
  adb -s "$s" shell dumpsys deviceidle whitelist +com.termux >/dev/null 2>&1
  adb -s "$s" shell dumpsys deviceidle whitelist +$CHROME >/dev/null 2>&1
}

ensure_chrome() {
  local s; s=$(serial)
  adb -s "$s" forward tcp:$CDP localabstract:chrome_devtools_remote >/dev/null || return 1
  cdp_ok && return 0
  # Socket DevTools hanya dibuat kalau Chrome dibuka SETELAH debugging aktif.
  say "Membuka ulang Chrome supaya DevTools aktif (tab Anda dipulihkan otomatis)…"
  adb -s "$s" shell am force-stop $CHROME
  # Lewat launcher, bukan nama activity: nama activity Chrome berubah antarversi (Chrome 157 tidak punya .Main).
  adb -s "$s" shell monkey -p $CHROME -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
  for _ in $(seq 1 20); do cdp_ok && break; sleep 1; done
  adb -s "$s" shell am start -n com.termux/.app.TermuxActivity >/dev/null 2>&1
  cdp_ok
}

cmd_start() {
  if running && healthy; then say "Sudah berjalan."; cmd_status; return 0; fi
  command -v adb >/dev/null || die "adb tidak ada. Jalankan ulang installer."
  connect_adb
  prep_android
  ensure_chrome || die "DevTools Chrome tidak terbuka. Pastikan Chrome terpasang dan Debug nirkabel nyala, lalu: gemuse start"
  termux-wake-lock 2>/dev/null || true
  mkdir -p "$DIR/data"
  cd "$DIR" || die "Folder $DIR hilang."
  nohup venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port $PORT >>"$LOG" 2>&1 &
  echo $! >"$PIDF"
  for _ in $(seq 1 60); do healthy && break; sleep 1; done
  healthy || die "Server tidak menyala. Lihat log: gemuse logs"
  say "GemuseAPI berjalan di http://127.0.0.1:$PORT/chat"
}

cmd_stop() {
  if running; then kill "$(cat "$PIDF")" 2>/dev/null; sleep 1; fi
  rm -f "$PIDF"
  termux-wake-unlock 2>/dev/null || true
  say "Server dihentikan."
}

cmd_status() {
  if running && healthy; then say "Server: jalan (http://127.0.0.1:$PORT/chat)"; else warn "Server: mati"; fi
  if [ -n "$(serial)" ]; then say "adb: tersambung"; else warn "adb: putus (gemuse start akan menyambung ulang)"; fi
  if cdp_ok; then say "Chrome DevTools: siap"; else warn "Chrome DevTools: belum siap"; fi
}

cmd_login() {
  connect_adb
  ensure_chrome || die "DevTools Chrome tidak terbuka."
  healthy || cmd_start
  "$DIR/venv/bin/python" "$DIR/deploy/termux/import_cookies.py" $CDP "http://127.0.0.1:$PORT" "$(api_key)" "${1:-}"
}

cmd_update() {
  bash "$DIR/deploy/termux/install.sh"
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  login) cmd_login "${2:-}" ;;
  pair) cmd_pair ;;
  update) cmd_update ;;
  logs) tail -n 80 -f "$LOG" ;;
  key) api_key ;;
  *)
    cat <<EOF
GemuseAPI untuk Termux
  gemuse start     nyalakan server (otomatis sambung adb + Chrome)
  gemuse login     impor login muse.ai dari Chrome HP (pengganti extension)
  gemuse status    cek server, adb, Chrome
  gemuse stop      matikan server
  gemuse restart   matikan lalu nyalakan lagi
  gemuse update    ambil versi terbaru (data Anda tidak dihapus)
  gemuse pair      ulangi pairing debug nirkabel
  gemuse logs      lihat log server
  gemuse key       tampilkan API key
EOF
    ;;
esac
